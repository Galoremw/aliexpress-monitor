{
  "manifest_version": 3,
  "name": "AliExpress 竞品监控采集助手",
  "version": "0.6.125",
  "description": "优先读取 IXSPY 店铺列表卡片的最近 7 日增量，并采集公开商品信息与评论。",
  "permissions": ["activeTab", "scripting", "tabs", "tabGroups", "webNavigation", "alarms", "notifications", "storage"],
  "host_permissions": [
    "https://www.aliexpress.com/*",
    "https://*.aliexpress.com/*",
    "https://aliexpress-monitor-api.onrender.com/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "http://192.168.66.115:3000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "采集当前商品",
    "default_popup": "popup/popup.html",
    "default_icon": "icon.svg"
  },
  "icons": { "128": "icon.svg" },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aliexpress.com/item/*",
        "https://www.aliexpress.com/item/*",
        "https://*.aliexpress.com/item/*",
        "https://aliexpress.com/store/*",
        "https://www.aliexpress.com/store/*",
        "https://*.aliexpress.com/store/*"
      ],
      "js": ["page_collector.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://aliexpress.com/item/*",
        "https://www.aliexpress.com/item/*",
        "https://*.aliexpress.com/item/*"
      ],
      "js": ["dianxiaomi_product_bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*",
        "http://192.168.66.115:3000/*",
        "http://127.0.0.1:8000/*",
        "https://galoremw.github.io/*",
        "https://*.onrender.com/*"
      ],
      "js": ["dashboard_bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
