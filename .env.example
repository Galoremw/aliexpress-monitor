APP_NAME=AliExpress Competitor Monitor
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
# Local: 127.0.0.1. Cloud VM: 0.0.0.0, protected by the server firewall/reverse proxy.
BACKEND_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1
POSTGRES_DB=monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=change-this-local-password
# Local default; replace this with a managed PostgreSQL connection string for cloud storage.
DATABASE_URL=postgresql+psycopg://monitor:change-this-local-password@postgres:5432/monitor
TIMEZONE=Asia/Shanghai
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=2
SCHEDULER_MINUTE=0
COLLECTOR_TIMEOUT_SECONDS=20
COLLECTOR_USER_AGENT=AliExpressMonitor/0.1 (+public-data-research)
FIRECRAWL_ENABLED=true
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_WAIT_FOR_MS=2000
FRONTEND_ALLOWED_ORIGINS=https://galoremw.github.io,http://127.0.0.1:3000,http://localhost:3000
AUTH_REQUIRED=true
# Generate a long random value for production, for example with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# These two values create the first admin account once. They are never stored in the database as plaintext.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-with-a-strong-password
